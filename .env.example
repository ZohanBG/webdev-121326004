# Every environment variable LabSpot reads, with harmless placeholder values.
# Copy to .env for local use. Real values go into Render's Environment settings, never into git.
# In a codespace, put the secret ones in the repository's Codespaces secrets instead of a file.
# At start-up the app checks them (src/config.js) and stops, naming the variable but never its
# value, when a required one is missing or wrong.

# The port to listen on. Default 3000. Render sets it: do not add it there.
PORT=3000

# "development" here. In production the Dockerfile sets NODE_ENV=production, which makes the
# session cookie Secure and turns on the production checks: do not copy this line to Render.
NODE_ENV=development

# Required. Secret. Neon dashboard, "Connect" (postgresql://...neon.tech/...?sslmode=require);
# locally, the Docker database. In production the app refuses this placeholder.
DATABASE_URL=postgres://user:password@host/dbname

# Sign in with Google: all three or none. With none, the button says Google is not set up here.
# Create an OAuth client at console.cloud.google.com and leave it in "Testing" mode with yourself
# as a test user: that is free and needs no app verification. Add every address you will sign in
# from as an authorized redirect URI (<PUBLIC_BASE_URL>/api/auth/google/callback), including your
# codespace's forwarded URL and your Render URL. Google requires https off localhost.
# PUBLIC_BASE_URL: the address people open, without a trailing slash; in production it must
# start with https://. GOOGLE_CLIENT_SECRET is secret; the client id is not.
PUBLIC_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: the model feature. Secret. A free key comes from aistudio.google.com (Get API key).
# The free tier is shared with the class, so 429 is expected. Without a key the app still works:
# suggestions fall back to the day view. gemini-2.5-flash is retired on 2026-12-01; use a current
# model id. GEMINI_MODEL is optional and defaults to gemini-3.5-flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Only for the MCP server (npm run mcp). Secret: a session token the server signs in with (the
# value of the labspot_session cookie after you sign in). It grants exactly what that user may do,
# and nothing more, because the tools go through the same services as the HTTP API.
MCP_TOKEN=

# Only for npm run seed: the password of the seeded development accounts. At least 10 characters
# (the seed refuses this placeholder). Never a password you use anywhere else.
SEED_PASSWORD=change-me